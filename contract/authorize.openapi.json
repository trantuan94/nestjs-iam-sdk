{
  "x-source": {
    "document": "nestjs-iam-service/swagger.json",
    "ref": "00bf159c2670260fc80e1466736903ceedb15f1c"
  },
  "info": {
    "title": "IAM Service",
    "version": "0.0.1"
  },
  "paths": {
    "/auth/authorize": {
      "post": {
        "description": "Check if a user (identified by their JWT) can perform an action on a registered resource type. Called by external services using their API key. Evaluates both RBAC (permission codes) and ABAC (attribute-based policies). Environment context (client IP, timestamp) is injected automatically.",
        "operationId": "authorize",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizeRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizeResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Over the per-API-key or per-IP limit (`RATE_LIMITED`); `Retry-After` says how many seconds remain.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "X-API-Key": []
          }
        ],
        "summary": "",
        "tags": [
          "auth"
        ]
      }
    },
    "/service/tokens/introspect": {
      "post": {
        "description": "The checks `/auth/authorize` makes — signature, type, an active account, not revoked, its session open, MFA cleared — and that the user is of the key's own project. Any refusal answers `{ active: false }` alone. Lets a service that verifies tokens locally see a revocation before the token expires.",
        "operationId": "serviceIntrospectToken",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenIntrospectionRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenIntrospectionResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "The key is not granted the permission (`API_KEY_PERMISSION_DENIED`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "X-API-Key": []
          }
        ],
        "summary": "Whether an end user's access token is still good",
        "tags": [
          "service"
        ]
      }
    },
    "/service/accounts/{userId}": {
      "get": {
        "operationId": "serviceGetAccount",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceAccountResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "The key is not granted the permission (`API_KEY_PERMISSION_DENIED`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "No such account in the key's own project (`ACCOUNT_NOT_FOUND`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "X-API-Key": []
          }
        ],
        "summary": "An account of the key's project, by id",
        "tags": [
          "service"
        ]
      }
    },
    "/service/accounts/lookup": {
      "post": {
        "description": "Up to 100 identifiers, matched ignoring case. Those with no account — or shared by two accounts differing by case alone — are absent from the answer. No contact details.",
        "operationId": "serviceLookupAccounts",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountLookupRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountLookupResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "The key is not granted the permission (`API_KEY_PERMISSION_DENIED`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "X-API-Key": []
          }
        ],
        "summary": "Accounts of the key's project, by identifier",
        "tags": [
          "service"
        ]
      }
    },
    "/service/accounts/contact": {
      "post": {
        "description": "For a service holding an API key granted `profiles:read`: the email address and name of an account of the key's own project, matched by identifier ignoring case. An unknown identifier, an account with no address and one that is not active all answer `email: null`. Every address returned is audited.",
        "operationId": "serviceAccountContact",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountContactRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountContactResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "The key is not granted `profiles:read` (`API_KEY_PERMISSION_DENIED`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Over the per-API-key limit (`RATE_LIMITED`), shared with /auth/authorize",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "X-API-Key": []
          }
        ],
        "summary": "An account's contact details, by identifier",
        "tags": [
          "service"
        ]
      }
    },
    "/service/accounts/{userId}/contact": {
      "get": {
        "description": "For a service holding an API key granted `profiles:read` and the user's id (`sub`): the email address and name of an account of the key's own project. An id outside that project is a 404; an account with no address or that is not active answers `email: null`. Every address returned is audited.",
        "operationId": "serviceAccountContactById",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountContactResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "The key is not granted `profiles:read` (`API_KEY_PERMISSION_DENIED`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "No such account in the key's own project (`ACCOUNT_NOT_FOUND`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "X-API-Key": []
          }
        ],
        "summary": "An account's contact details, by id",
        "tags": [
          "service"
        ]
      }
    },
    "/service/roles": {
      "get": {
        "operationId": "serviceListRoles",
        "parameters": [
          {
            "name": "searchKey",
            "required": false,
            "in": "query",
            "description": "Case-insensitive partial match on code or name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Page number (1-based). Default: 1",
            "schema": {
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Items per page. Default: 20, max: 100",
            "schema": {
              "example": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceRoleListResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "The key is not granted the permission (`API_KEY_PERMISSION_DENIED`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "X-API-Key": []
          }
        ],
        "summary": "The roles of the key's project",
        "tags": [
          "service"
        ]
      }
    },
    "/service/accounts/{userId}/roles": {
      "get": {
        "operationId": "serviceGetAccountRoles",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountRolesResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "The key is not granted the permission (`API_KEY_PERMISSION_DENIED`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "No such account in the key's own project (`ACCOUNT_NOT_FOUND`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "X-API-Key": []
          }
        ],
        "summary": "The roles assigned to an account of the key's project",
        "tags": [
          "service"
        ]
      }
    },
    "/service/accounts/{userId}/permissions": {
      "get": {
        "operationId": "serviceGetAccountPermissions",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountPermissionsResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "The key is not granted the permission (`API_KEY_PERMISSION_DENIED`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "No such account in the key's own project (`ACCOUNT_NOT_FOUND`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "X-API-Key": []
          }
        ],
        "summary": "The permission codes an account of the key's project holds",
        "tags": [
          "service"
        ]
      }
    },
    "/service/resource-types": {
      "get": {
        "operationId": "serviceListResourceTypes",
        "parameters": [
          {
            "name": "searchKey",
            "required": false,
            "in": "query",
            "description": "Case-insensitive partial match on code or name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Page number (1-based). Default: 1",
            "schema": {
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Items per page. Default: 20, max: 100",
            "schema": {
              "example": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceResourceTypeListResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "The key is not granted the permission (`API_KEY_PERMISSION_DENIED`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "X-API-Key": []
          }
        ],
        "summary": "The resource types of the key's project, with their actions",
        "tags": [
          "service"
        ]
      },
      "put": {
        "description": "For a resource service holding an API key granted `resource-types:sync`, typically at deploy or boot: every type it serves, with its actions. Types the project lacks are created, missing actions added, `name` / `description` / `attributes` set to the declaration. Without `prune`, nothing is taken away — what the project has beyond the manifest is reported (`undeclared`, `undeclaredActions`). With `prune`, undeclared actions are narrowed away — their grants stripped from every role — and undeclared types deleted, unless a role holds one (`delete-refused`). The derived permission codes grant nothing until an operator puts them in a role. Not atomic: each type is written on its own, and sending the same manifest again finishes a sync that failed part way. `?dryRun=true` answers the same results and writes nothing. Each change is audited, naming the key.",
        "operationId": "serviceSyncResourceTypes",
        "parameters": [
          {
            "name": "dryRun",
            "required": false,
            "in": "query",
            "description": "Answer what the sync would do, writing nothing — for a CI check before a deploy.",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncResourceTypesDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "What was done to each type (or would be, under `dryRun`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResourceTypesResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "The manifest is malformed — a code declared twice or reserved by the platform included — and nothing was written (`VALIDATION_EXCEPTION`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "The key is not granted `resource-types:sync` (`API_KEY_PERMISSION_DENIED`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "X-API-Key": []
          }
        ],
        "summary": "Declare the resource types of the key's project",
        "tags": [
          "service"
        ]
      }
    },
    "/service/accounts/{userId}/sessions/revoke": {
      "post": {
        "description": "For a service holding an API key granted `sessions:revoke` that sees a compromise: every session of the account ends — its refresh tokens, so every access token too — and every device's trust is cleared, as an operator's Revoke Sessions does. The account's status is untouched, so its holder can sign in again. Audited, naming the key.",
        "operationId": "serviceRevokeAccountSessions",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Every session ended"
          },
          "403": {
            "description": "The key is not granted `sessions:revoke` (`API_KEY_PERMISSION_DENIED`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "No such account in the key's own project (`ACCOUNT_NOT_FOUND`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "X-API-Key": []
          }
        ],
        "summary": "Sign an account of the key's project out everywhere",
        "tags": [
          "service"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AuthorizeRequestDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "User's JWT access token forwarded from the external service"
          },
          "resource": {
            "type": "object",
            "description": "Resource attributes — must include \"type\" (registered resource type code). Additional attributes (id, namespaceId, ...) are used by ABAC conditions.",
            "example": {
              "type": "products",
              "id": "prod-123",
              "namespaceId": "ns-1"
            }
          },
          "action": {
            "type": "string",
            "example": "products:read",
            "description": "The full permission code to check, `<resourceType>:<action>` — e.g. \"products:read\" for a tenant type, or \"master:users:read\" for the platform `users` type. It must be one the resource type carries."
          },
          "environment": {
            "type": "object",
            "description": "Additional environment attributes passed to ABAC conditions. Server always injects ip (from request headers) and timestamp — these cannot be overridden by the caller.",
            "example": {
              "region": "us-east-1"
            }
          }
        },
        "required": [
          "token",
          "resource",
          "action"
        ]
      },
      "AuthorizeResponseDto": {
        "type": "object",
        "properties": {
          "allowed": {
            "type": "boolean",
            "description": "Whether the user is allowed to perform the action"
          },
          "userId": {
            "type": "string",
            "description": "User ID extracted from the token"
          },
          "action": {
            "type": "string",
            "example": "products:read",
            "description": "The permission code that was checked, as sent"
          },
          "resourceType": {
            "type": "string",
            "example": "products"
          }
        },
        "required": [
          "allowed",
          "userId",
          "action",
          "resourceType"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400,
            "description": "HTTP status code"
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_EXCEPTION",
            "description": "Stable error identifier. Branch on this, never on `message`, which is prose."
          },
          "errorCode": {
            "type": "string",
            "example": "9300009",
            "description": "Numeric error code: 93 + 00 + the ErrorCode enum value"
          },
          "message": {
            "type": "string",
            "example": "Validation exception",
            "description": "Short summary, stable for a given `code`"
          },
          "description": {
            "type": "string",
            "example": "namespaceId must be a UUID",
            "description": "Explanation specific to this occurrence"
          },
          "errors": {
            "description": "Each field the request got wrong — validation failures only",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          },
          "path": {
            "type": "string",
            "example": "/api/iam/users",
            "description": "Request path"
          },
          "method": {
            "type": "string",
            "example": "POST",
            "description": "Request method"
          },
          "requestId": {
            "type": "string",
            "example": "018f3a...",
            "description": "Correlation id stamped by RequestIdMiddleware. Quote this in a support report."
          },
          "timestamp": {
            "type": "string",
            "example": "2026-08-21T00:00:00.000Z",
            "description": "ISO-8601 timestamp"
          }
        },
        "required": [
          "statusCode",
          "code",
          "errorCode",
          "message",
          "description",
          "path",
          "method",
          "timestamp"
        ]
      },
      "TokenIntrospectionRequestDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "An end user's access token, forwarded by the resource service. In the body, so it stays out of access logs"
          }
        },
        "required": [
          "token"
        ]
      },
      "TokenIntrospectionResponseDto": {
        "type": "object",
        "properties": {
          "active": {
            "type": "boolean"
          },
          "sub": {
            "type": "string",
            "format": "uuid",
            "description": "The user id"
          },
          "identifier": {
            "type": "string",
            "example": "ada.lovelace"
          },
          "sessionId": {
            "type": "string",
            "nullable": true,
            "description": "The session the token was minted for"
          },
          "mfaCleared": {
            "type": "boolean",
            "description": "Whether the session may pass the MFA gate (Clearance)"
          },
          "exp": {
            "type": "number",
            "description": "Expiry, in seconds since the epoch",
            "example": 1767225600
          }
        },
        "required": [
          "active"
        ]
      },
      "ServiceAccountResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "identifier": {
            "type": "string",
            "example": "ada.lovelace"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserStatus"
              }
            ]
          },
          "isVerified": {
            "type": "boolean",
            "description": "Whether the email address was verified"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "identifier",
          "status",
          "isVerified",
          "createdAt"
        ]
      },
      "AccountLookupRequestDto": {
        "type": "object",
        "properties": {
          "identifiers": {
            "minItems": 1,
            "maxItems": 100,
            "example": [
              "ada.lovelace",
              "grace.hopper"
            ],
            "description": "Identifiers in the API key's own project, matched ignoring case. In the body, not the URL, so they stay out of access logs",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "identifiers"
        ]
      },
      "AccountLookupResponseDto": {
        "type": "object",
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceAccountResponseDto"
            }
          }
        },
        "required": [
          "accounts"
        ]
      },
      "AccountContactRequestDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "example": "ada.lovelace",
            "maxLength": 50,
            "description": "The account's identifier in the API key's own project, matched ignoring case. In the body, not the URL, so it stays out of access logs"
          }
        },
        "required": [
          "identifier"
        ]
      },
      "AccountContactResponseDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true,
            "example": "ada@example.com"
          },
          "firstName": {
            "type": "string",
            "nullable": true,
            "example": "Ada"
          },
          "lastName": {
            "type": "string",
            "nullable": true,
            "example": "Lovelace"
          }
        },
        "required": [
          "email",
          "firstName",
          "lastName"
        ]
      },
      "ServiceRoleResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "example": "editor"
          },
          "name": {
            "type": "string",
            "example": "Editor"
          }
        },
        "required": [
          "id",
          "code",
          "name"
        ]
      },
      "ServiceRoleListResponseDto": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          },
          "hasNext": {
            "type": "boolean"
          },
          "hasPrev": {
            "type": "boolean"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceRoleResponseDto"
            }
          }
        },
        "required": [
          "total",
          "page",
          "limit",
          "totalPages",
          "hasNext",
          "hasPrev",
          "data"
        ]
      },
      "AccountRolesResponseDto": {
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceRoleResponseDto"
            }
          }
        },
        "required": [
          "roles"
        ]
      },
      "AccountPermissionsResponseDto": {
        "type": "object",
        "properties": {
          "permissions": {
            "example": [
              "products:read",
              "products:write"
            ],
            "description": "The permission codes the account holds, sorted",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "permissions"
        ]
      },
      "ServiceResourceTypeResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "example": "products"
          },
          "name": {
            "type": "string",
            "example": "Products"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "allowedActions": {
            "example": [
              "read",
              "write"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "description",
          "allowedActions"
        ]
      },
      "ServiceResourceTypeListResponseDto": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          },
          "hasNext": {
            "type": "boolean"
          },
          "hasPrev": {
            "type": "boolean"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceResourceTypeResponseDto"
            }
          }
        },
        "required": [
          "total",
          "page",
          "limit",
          "totalPages",
          "hasNext",
          "hasPrev",
          "data"
        ]
      },
      "SyncResourceTypesDto": {
        "type": "object",
        "properties": {
          "resourceTypes": {
            "maxItems": 100,
            "description": "Every type the service serves. Empty is allowed: with `prune`, it removes every type of the project that no role holds.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResourceTypeDeclarationDto"
            }
          },
          "prune": {
            "type": "boolean",
            "default": false,
            "description": "Also take away what the manifest does not declare: actions are narrowed (their grants stripped from every role, their policies retired) and types deleted — a type a role still holds is kept and reported `delete-refused`. Off, the sync only adds."
          }
        },
        "required": [
          "resourceTypes"
        ]
      },
      "ResourceTypeDeclarationDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "products",
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "example": "Products",
            "maxLength": 150
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 255,
            "description": "Absent keeps the stored description; `null` clears it."
          },
          "allowedActions": {
            "example": [
              "read",
              "create",
              "update"
            ],
            "description": "The actions the type carries. Without `prune`, actions IAM has that are not listed are kept and reported as `undeclaredActions`.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "number",
                    "boolean",
                    "date",
                    "array",
                    "object"
                  ]
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "type"
              ]
            },
            "example": {
              "status": {
                "type": "string",
                "required": true
              },
              "customerId": {
                "type": "string",
                "required": true
              },
              "amount": {
                "type": "number",
                "required": false
              }
            },
            "description": "Custom attribute schema: map of attribute name → { type, required? }. Absent keeps the stored map; present replaces it whole."
          }
        },
        "required": [
          "code",
          "name",
          "allowedActions"
        ]
      },
      "SyncResourceTypesResponseDto": {
        "type": "object",
        "properties": {
          "dryRun": {
            "type": "boolean",
            "description": "True when nothing was written"
          },
          "prune": {
            "type": "boolean"
          },
          "results": {
            "description": "One per type: the manifest's in its order, then every type it does not declare, by code.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResourceTypeSyncResultDto"
            }
          }
        },
        "required": [
          "dryRun",
          "prune",
          "results"
        ]
      },
      "ResourceTypeSyncResultDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "products"
          },
          "outcome": {
            "description": "`undeclared`: IAM has the type, the manifest does not, and `prune` is off. `delete-refused`: `prune` is on but a role holds one of its codes.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ResourceTypeSyncOutcome"
              }
            ]
          },
          "addedActions": {
            "description": "Actions the type carries now that it did not",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "removedActions": {
            "description": "Actions taken away — only with `prune`, or by a delete",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "undeclaredActions": {
            "description": "Actions the type carries that the manifest does not name, kept because `prune` is off",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fieldsChanged": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "name",
                "description",
                "attributes"
              ]
            }
          }
        },
        "required": [
          "code",
          "outcome",
          "addedActions",
          "removedActions",
          "undeclaredActions",
          "fieldsChanged"
        ]
      },
      "ResourceTypeSyncOutcome": {
        "type": "string",
        "enum": [
          "created",
          "updated",
          "unchanged",
          "deleted",
          "delete-refused",
          "undeclared"
        ],
        "description": "`undeclared`: IAM has the type, the manifest does not, and `prune` is off. `delete-refused`: `prune` is on but a role holds one of its codes."
      }
    }
  }
}
