  "info": {
    "title": "IAM Service",
    "version": "0.0.1"
  },
  "paths": {
    "/auth/authorize": {
      "post": {
        "description": "Check if a user (identified by their JWT) can perform an action on a registered resource type. Called by external services using their API key. Evaluates both RBAC (permission codes) and ABAC (attribute-based policies). Environment context (client IP, timestamp) is injected automatically.",
        "operationId": "authorize",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizeRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizeResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Over the per-API-key or per-IP limit (`RATE_LIMITED`); `Retry-After` says how many seconds remain.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "X-API-Key": []
          }
        ],
        "summary": "",
        "tags": [
          "auth"
        ]
      }
    },
    "/service/tokens/introspect": {
      "post": {
        "description": "The checks `/auth/authorize` makes — signature, type, an active account, not revoked, its session open, MFA cleared — and that the user is of the key's own project. Any refusal answers `{ active: false }` alone. Lets a service that verifies tokens locally see a revocation before the token expires.",
        "operationId": "serviceIntrospectToken",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenIntrospectionRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenIntrospectionResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "The key is not granted the permission (`API_KEY_PERMISSION_DENIED`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "X-API-Key": []
          }
        ],
        "summary": "Whether an end user's access token is still good",
        "tags": [
          "service"
        ]
      }
    },
    "/service/accounts/{userId}": {
      "get": {
        "operationId": "serviceGetAccount",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceAccountResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "The key is not granted the permission (`API_KEY_PERMISSION_DENIED`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "No such account in the key's own project (`ACCOUNT_NOT_FOUND`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "X-API-Key": []
          }
        ],
        "summary": "An account of the key's project, by id",
        "tags": [
          "service"
        ]
      }
    },
    "/service/accounts/lookup": {
      "post": {
        "description": "Up to 100 identifiers, matched ignoring case. Those with no account — or shared by two accounts differing by case alone — are absent from the answer. No contact details.",
        "operationId": "serviceLookupAccounts",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountLookupRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountLookupResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "The key is not granted the permission (`API_KEY_PERMISSION_DENIED`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "X-API-Key": []
          }
        ],
        "summary": "Accounts of the key's project, by identifier",
        "tags": [
          "service"
        ]
      }
    },
    "/service/accounts/contact": {
      "post": {
        "description": "For a service holding an API key granted `profiles:read`: the email address and name of an account of the key's own project, matched by identifier ignoring case. An unknown identifier, an account with no address and one that is not active all answer `email: null`. Every address returned is audited.",
        "operationId": "serviceAccountContact",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountContactRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountContactResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "The key is not granted `profiles:read` (`API_KEY_PERMISSION_DENIED`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Over the per-API-key limit (`RATE_LIMITED`), shared with /auth/authorize",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "X-API-Key": []
          }
        ],
        "summary": "An account's contact details, by identifier",
        "tags": [
          "service"
        ]
      }
    },
    "/service/accounts/{userId}/contact": {
      "get": {
        "description": "For a service holding an API key granted `profiles:read` and the user's id (`sub`): the email address and name of an account of the key's own project. An id outside that project is a 404; an account with no address or that is not active answers `email: null`. Every address returned is audited.",
        "operationId": "serviceAccountContactById",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountContactResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "The key is not granted `profiles:read` (`API_KEY_PERMISSION_DENIED`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "No such account in the key's own project (`ACCOUNT_NOT_FOUND`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "X-API-Key": []
          }
        ],
        "summary": "An account's contact details, by id",
        "tags": [
          "service"
        ]
      }
    },
    "/service/roles": {
      "get": {
        "operationId": "serviceListRoles",
        "parameters": [
          {
            "name": "searchKey",
            "required": false,
            "in": "query",
            "description": "Case-insensitive partial match on code or name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Page number (1-based). Default: 1",
            "schema": {
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Items per page. Default: 20, max: 100",
            "schema": {
              "example": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceRoleListResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "The key is not granted the permission (`API_KEY_PERMISSION_DENIED`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "X-API-Key": []
          }
        ],
        "summary": "The roles of the key's project",
        "tags": [
          "service"
        ]
      }
    },
    "/service/accounts/{userId}/roles": {
      "get": {
        "operationId": "serviceGetAccountRoles",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountRolesResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "The key is not granted the permission (`API_KEY_PERMISSION_DENIED`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "No such account in the key's own project (`ACCOUNT_NOT_FOUND`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "X-API-Key": []
          }
        ],
        "summary": "The roles assigned to an account of the key's project",
        "tags": [
          "service"
        ]
      }
    },
    "/service/accounts/{userId}/permissions": {
      "get": {
        "operationId": "serviceGetAccountPermissions",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountPermissionsResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "The key is not granted the permission (`API_KEY_PERMISSION_DENIED`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "No such account in the key's own project (`ACCOUNT_NOT_FOUND`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "X-API-Key": []
          }
        ],
        "summary": "The permission codes an account of the key's project holds",
        "tags": [
          "service"
        ]
      }
    },
    "/service/resource-types": {
      "get": {
        "operationId": "serviceListResourceTypes",
        "parameters": [
          {
            "name": "searchKey",
            "required": false,
            "in": "query",
            "description": "Case-insensitive partial match on code or name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Page number (1-based). Default: 1",
            "schema": {
              "example": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Items per page. Default: 20, max: 100",
            "schema": {
              "example": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceResourceTypeListResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "The key is not granted the permission (`API_KEY_PERMISSION_DENIED`)",
            "content": {
              "application/json": {
