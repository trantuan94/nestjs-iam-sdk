        "summary": "The resource types of the key's project, with their actions",
        "tags": [
          "service"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AuthorizeRequestDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "User's JWT access token forwarded from the external service"
          },
          "resource": {
            "type": "object",
            "description": "Resource attributes — must include \"type\" (registered resource type code). Additional attributes (id, namespaceId, ...) are used by ABAC conditions.",
            "example": {
              "type": "products",
              "id": "prod-123",
              "namespaceId": "ns-1"
            }
          },
          "action": {
            "type": "string",
            "example": "products:read",
            "description": "The full permission code to check, `<resourceType>:<action>` — e.g. \"products:read\" for a tenant type, or \"master:users:read\" for the platform `users` type. It must be one the resource type carries."
          },
          "environment": {
            "type": "object",
            "description": "Additional environment attributes passed to ABAC conditions. Server always injects ip (from request headers) and timestamp — these cannot be overridden by the caller.",
            "example": {
              "region": "us-east-1"
            }
          }
        },
        "required": [
          "token",
          "resource",
          "action"
        ]
      },
      "AuthorizeResponseDto": {
        "type": "object",
        "properties": {
          "allowed": {
            "type": "boolean",
            "description": "Whether the user is allowed to perform the action"
          },
          "userId": {
            "type": "string",
            "description": "User ID extracted from the token"
          },
          "action": {
            "type": "string",
            "example": "products:read",
            "description": "The permission code that was checked, as sent"
          },
          "resourceType": {
            "type": "string",
            "example": "products"
          }
        },
        "required": [
          "allowed",
          "userId",
          "action",
          "resourceType"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400,
            "description": "HTTP status code"
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_EXCEPTION",
            "description": "Stable error identifier. Branch on this, never on `message`, which is prose."
          },
          "errorCode": {
            "type": "string",
            "example": "9300009",
            "description": "Numeric error code: 93 + 00 + the ErrorCode enum value"
          },
          "message": {
            "type": "string",
            "example": "Validation exception",
            "description": "Short summary, stable for a given `code`"
          },
          "description": {
            "type": "string",
            "example": "namespaceId must be a UUID",
            "description": "Explanation specific to this occurrence"
          },
          "errors": {
            "description": "Each field the request got wrong — validation failures only",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          },
          "path": {
            "type": "string",
            "example": "/api/iam/users",
            "description": "Request path"
          },
          "method": {
            "type": "string",
            "example": "POST",
            "description": "Request method"
          },
          "requestId": {
            "type": "string",
            "example": "018f3a...",
            "description": "Correlation id stamped by RequestIdMiddleware. Quote this in a support report."
          },
          "timestamp": {
            "type": "string",
            "example": "2026-08-21T00:00:00.000Z",
            "description": "ISO-8601 timestamp"
          }
        },
        "required": [
          "statusCode",
          "code",
          "errorCode",
          "message",
          "description",
          "path",
          "method",
          "timestamp"
        ]
      },
      "TokenIntrospectionRequestDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "An end user's access token, forwarded by the resource service. In the body, so it stays out of access logs"
          }
        },
        "required": [
          "token"
        ]
      },
      "TokenIntrospectionResponseDto": {
        "type": "object",
        "properties": {
          "active": {
            "type": "boolean"
          },
          "sub": {
            "type": "string",
            "format": "uuid",
            "description": "The user id"
          },
          "identifier": {
            "type": "string",
            "example": "ada.lovelace"
          },
          "sessionId": {
            "type": "string",
            "nullable": true,
            "description": "The session the token was minted for"
          },
          "mfaCleared": {
            "type": "boolean",
            "description": "Whether the session may pass the MFA gate (Clearance)"
          },
          "exp": {
            "type": "number",
            "description": "Expiry, in seconds since the epoch",
            "example": 1767225600
          }
        },
        "required": [
          "active"
        ]
      },
      "ServiceAccountResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "identifier": {
            "type": "string",
            "example": "ada.lovelace"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserStatus"
              }
            ]
          },
          "isVerified": {
            "type": "boolean",
            "description": "Whether the email address was verified"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "identifier",
          "status",
          "isVerified",
          "createdAt"
        ]
      },
      "AccountLookupRequestDto": {
        "type": "object",
        "properties": {
          "identifiers": {
            "minItems": 1,
            "maxItems": 100,
            "example": [
              "ada.lovelace",
              "grace.hopper"
            ],
            "description": "Identifiers in the API key's own project, matched ignoring case. In the body, not the URL, so they stay out of access logs",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "identifiers"
        ]
      },
      "AccountLookupResponseDto": {
        "type": "object",
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceAccountResponseDto"
            }
          }
        },
        "required": [
          "accounts"
        ]
      },
      "AccountContactRequestDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "example": "ada.lovelace",
            "maxLength": 50,
            "description": "The account's identifier in the API key's own project, matched ignoring case. In the body, not the URL, so it stays out of access logs"
          }
        },
        "required": [
          "identifier"
        ]
      },
      "AccountContactResponseDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true,
            "example": "ada@example.com"
          },
          "firstName": {
            "type": "string",
            "nullable": true,
            "example": "Ada"
          },
          "lastName": {
            "type": "string",
            "nullable": true,
            "example": "Lovelace"
          }
        },
        "required": [
          "email",
          "firstName",
          "lastName"
        ]
      },
      "ServiceRoleResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "example": "editor"
          },
          "name": {
            "type": "string",
            "example": "Editor"
          }
        },
        "required": [
          "id",
          "code",
          "name"
        ]
      },
      "ServiceRoleListResponseDto": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          },
          "totalPages": {
            "type": "number"
          },
          "hasNext": {
            "type": "boolean"
          },
          "hasPrev": {
            "type": "boolean"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceRoleResponseDto"
            }
          }
        },
        "required": [
          "total",
          "page",
          "limit",
          "totalPages",
          "hasNext",
          "hasPrev",
          "data"
        ]
      },
      "AccountRolesResponseDto": {
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceRoleResponseDto"
            }
          }
        },
        "required": [
          "roles"
        ]
      },
      "AccountPermissionsResponseDto": {
        "type": "object",
        "properties": {
          "permissions": {
            "example": [
              "products:read",
              "products:write"
            ],
            "description": "The permission codes the account holds, sorted",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "permissions"
        ]
      },
      "ServiceResourceTypeResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "example": "products"
          },
          "name": {
            "type": "string",
            "example": "Products"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "allowedActions": {
            "example": [
              "read",
              "write"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "description",
          "allowedActions"
