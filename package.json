{
  "name": "@trantuan94/nestjs-iam-sdk",
  "version": "0.1.0",
  "description": "NestJS decorators, guard and client for nestjs-iam-service's POST /auth/authorize — fail-closed authorization for resource services.",
  "keywords": [
    "nestjs",
    "iam",
    "authorization",
    "rbac",
    "abac",
    "guard",
    "decorator"
  ],
  "license": "MIT",
  "author": "Tuan Tran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trantuan94/nestjs-iam-sdk.git"
  },
  "homepage": "https://github.com/trantuan94/nestjs-iam-sdk#readme",
  "bugs": "https://github.com/trantuan94/nestjs-iam-sdk/issues",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "testing": [
        "dist/testing/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --maxWorkers=4",
    "test:cov": "jest --maxWorkers=4 --coverage",
    "contract:update": "node scripts/update-contract.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build",
    "mutate": "stryker run"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/swagger": "^7.0.0 || ^8.0.0 || ^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/swagger": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/testing": "^11.2.7",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.2"
  }
}
